{
  "operationId": "PostModelCredentials",
  "path": "/v1/model/credentials",
  "method": "post",
  "success": {
    "schema": "ModelCredential",
    "status": "200",
    "required": ["configuration", "credential"]
  },
  "credential": {
    "schema": "ModelProviderKey",
    "required": ["apiKey", "expiresAt"]
  },
  "configuration": {
    "schema": "ModelConfiguration",
    "required": ["baseUrl", "inference", "provider", "region"]
  },
  "inference": {
    "schema": "ModelInference",
    "required": ["enable_thinking", "model", "response_format"]
  },
  "responseFormat": {
    "schema": "ModelResponseFormat",
    "required": ["json_schema", "type"]
  },
  "errors": {
    "401": [
      "credential_expired",
      "credential_invalid",
      "credential_missing",
      "credential_revoked"
    ],
    "500": ["internal_error"],
    "502": ["model_provider_error"],
    "503": ["model_configuration_unavailable", "service_unavailable"]
  }
}
