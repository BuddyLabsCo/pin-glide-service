# Keep this project name stable and unique per installation (network and volumes).
COMPOSE_PROJECT_NAME=pin-glide-service
# Literal X.Y.Z, without v. Both release images use exactly this tag.
RELEASE=0.1.0
# Set both credentials before first deployment. Usernames must be URL-safe.
POSTGRES_USER=pin_glide
# Set before first deployment. Use a long random URL-safe alphanumeric password.
# Do not change this on an existing volume without a separate password rotation.
POSTGRES_PASSWORD=9b60112792a1d4f23f081d8371e60aa53a0d5143a9ce1458
# Optional identity providers. Set a complete pair to enable that provider;
# missing or partial pairs fail only when the provider is used.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
QQ_APP_ID=1905837151
QQ_APP_KEY=mTyDDxSoyve9QTN5
# The parent API key of the approved Bailian Beijing Workspace. Set it before
# the first deployment; the api refuses to start in production without it. The
# enabled Workspace/model row lives in PostgreSQL, not here.
BAILIAN_API_KEY=sk-ws-H.PYPEIHL.jWBQ.MEUCIQD_OE75jNm5b0hWIyGsK0YcDtyeVufr50BcaoDa9CH9_gIgc8RkZYAPbbz3lpYd7Hq13FiNrOHfJNzDuEx30dJpIx8

# Optional automatic snapshots. The directory must already exist on this host
# and the Docker daemon, writable by the invoking cron user's UID/GID.
PIN_GLIDE_SNAPSHOT_PATH=/mnt/share/workspace/snapshots/pin-glide
# Daily time in the host timezone; retention counts completed snapshots only.
PIN_GLIDE_SNAPSHOT_TIME=03:00
PIN_GLIDE_SNAPSHOT_KEEP=7
